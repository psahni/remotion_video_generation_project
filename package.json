{
  "name": "tech-scaling-video",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Remotion video generation engine with topic-based video definitions",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run render:topic -- --topic scaling --output out/scaling.mp4",
    "render:topic": "node scripts/render-topic.mjs",
    "render:scene5": "npm run render:topic -- --topic scaling --scene comparison --output out/scaling-scene5.mp4",
    "render:frames": "node scripts/render-frames.mjs --topic scaling",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && node scripts/validate-timeline.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/media": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
